{
  "id": "/",
  "name": "Let's Learn",
  "short_name": "Let's Learn",
  "description": "A colorful learning world for Baby Class to Primary 3. Lessons, games, songs and art — works offline.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#8ed3ff",
  "theme_color": "#8ed3ff",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education", "kids", "games"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Learn",
      "short_name": "Learn",
      "description": "Open lessons and activity areas",
      "url": "/#/learn",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Play",
      "short_name": "Play",
      "description": "Open educational games",
      "url": "/#/play",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Creative",
      "short_name": "Create",
      "description": "Coloring, tracing and drawing",
      "url": "/#/creative",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
